# Verdix static SPA — served with the same security posture as the old Netlify config.
:8080 {
	root * /srv
	encode gzip zstd

	# Security headers on every response.
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		# Strict CSP: only our own origin can run scripts (blocks injected/XSS <script>). Styles allow
		# inline (React/ECharts) + Google Fonts; map workers need blob:.
		# GOOGLE SIGN-IN IS ON (config.ts AUTH_ENABLED=true), so connect-src also carries the Firebase
		# Auth + Firestore endpoints, and frame-src carries the auth helper iframe on the project's
		# authDomain plus accounts.google.com. img-src carries *.googleusercontent.com, which is where
		# Google serves the signed-in user's profile photo — without it the avatar is refused and the
		# account button shows a broken image. ⚠ script-src MUST allow https://apis.google.com —
		# Firebase Auth loads apis.google.com/js/api.js for its iframe manager even on the v9 modular
		# SDK, and with script-src 'self' alone the popup never opens and sign-in silently dies.
		# If sign-in is ever switched back off, these can all be dropped.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://apis.google.com https://www.gstatic.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.googleusercontent.com; connect-src 'self' https://apis.google.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://firestore.googleapis.com https://*.firebaseio.com; frame-src 'self' https://verdix-d369c.firebaseapp.com https://accounts.google.com; upgrade-insecure-requests"
		-Server
	}

	# Anti-scrape: /data + /geo are only readable by our own app (same-origin browser fetch);
	# direct hits, curl, bots and hotlinks (no/other Sec-Fetch-Site) get 403.
	@scrape {
		path /data/* /geo/*
		not header Sec-Fetch-Site same-origin
		not header Sec-Fetch-Site same-site
	}
	respond @scrape "Forbidden — this endpoint is only available to the Verdix app." 403

	# Caching: content-hashed assets are immutable; data/geometry are shorter-lived.
	@immutable path /assets/* /glyphs/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@data path /data/*
	header @data Cache-Control "public, max-age=3600"
	@geo path /geo/*
	header @geo Cache-Control "public, max-age=86400"

	# SPA fallback: client routes → index.html; real files served directly.
	try_files {path} /index.html
	file_server
}
