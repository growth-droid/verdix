# Firebase web config for Verdix login (Google Sign-In + the allow-list).
# These are PUBLIC values — safe in the browser bundle; access is enforced by firestore.rules.
# Setup: copy this file to `.env.local` (gitignored) and fill in the values from
#   Firebase console → Project settings → General → Your apps → Web app → SDK setup and config.
# Vite inlines VITE_* vars at BUILD time, so rebuild (`npm run build`) after changing them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
